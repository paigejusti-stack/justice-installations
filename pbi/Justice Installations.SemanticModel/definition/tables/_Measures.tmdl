	/// Value for each Lead Funnel stage (driven by the disconnected Lead Funnel Stages table).
	measure 'Lead Funnel Value' =
			SWITCH ( SELECTEDVALUE ( 'Lead Funnel Stages'[Stage] ),
			    "Total Leads", [Total Leads],
			    "Converted",   [Converted Leads],
			    "Declined",    [Declined Leads],
			    "Open",        [Open Leads] )
		formatString: #,0
		displayFolder: 03 Leads & Pipeline
		lineageTag: b1000001-0031-4a01-9a01-000000000031

	/// Per-stage color for the Lead Funnel visual.
	measure 'Lead Funnel Color' =
			SWITCH ( SELECTEDVALUE ( 'Lead Funnel Stages'[Stage] ),
			    "Total Leads", "#5B9BD5",
			    "Converted",   "#5DBF7A",
			    "Declined",    "#D9534F",
			    "Open",        "#E6A817",
			    "#A8B0C5" )
		isHidden
		displayFolder: 03 Leads & Pipeline
		lineageTag: b1000001-0032-4a01-9a01-000000000032

	/// Composite technician performance, 0-100. Min-max normalized across visible technicians and weighted: Revenue 30%, Completed Jobs 20%, Completion Rate 20%, Avg Rating 20%, low Cancellation 10%.
	measure 'Performance Score' =
			VAR _t = ALL ( Technician )
			VAR _revMin = MINX ( _t, [Revenue (Completed Jobs)] )
			VAR _revMax = MAXX ( _t, [Revenue (Completed Jobs)] )
			VAR _jobMin = MINX ( _t, [Completed Jobs] )
			VAR _jobMax = MAXX ( _t, [Completed Jobs] )
			VAR _compMin = MINX ( _t, [Completion Rate] )
			VAR _compMax = MAXX ( _t, [Completion Rate] )
			VAR _rateMin = MINX ( _t, [Avg Customer Rating] )
			VAR _rateMax = MAXX ( _t, [Avg Customer Rating] )
			VAR _cancMin = MINX ( _t, [Cancellation Rate %] )
			VAR _cancMax = MAXX ( _t, [Cancellation Rate %] )
			VAR _nRev = DIVIDE ( [Revenue (Completed Jobs)] - _revMin, _revMax - _revMin )
			VAR _nJob = DIVIDE ( [Completed Jobs] - _jobMin, _jobMax - _jobMin )
			VAR _nComp = DIVIDE ( [Completion Rate] - _compMin, _compMax - _compMin )
			VAR _nRate = DIVIDE ( [Avg Customer Rating] - _rateMin, _rateMax - _rateMin )
			VAR _nCanc = 1 - DIVIDE ( [Cancellation Rate %] - _cancMin, _cancMax - _cancMin )
			RETURN
			    IF ( ISBLANK ( [Completed Jobs] ), BLANK (),
			        100 * ( 0.30 * _nRev + 0.20 * _nJob + 0.20 * _nComp + 0.20 * _nRate + 0.10 * _nCanc ) )
		formatString: 0.0
		displayFolder: 02 Jobs & Operations
		lineageTag: b1000001-0034-4a01-9a01-000000000034

	/// Overall technician rank, 1 = best (ranks by Performance Score).
	measure 'Performance Rank' =
			IF ( HASONEVALUE ( Technician[Technician Name] ),
			    RANKX ( ALL ( Technician ), [Performance Score],, DESC, DENSE ) )
		formatString: 0
		displayFolder: 02 Jobs & Operations
		lineageTag: b1000001-0035-4a01-9a01-000000000035

	/// Star rating from overall performance rank (rank 1 = 5 stars, descending).
	measure 'Rating Stars' =
			VAR _rank = [Performance Rank]
			VAR _f = MIN ( 5, MAX ( 1, 6 - _rank ) )
			RETURN IF ( ISBLANK ( _rank ), "", REPT ( "★", _f ) & REPT ( "☆", 5 - _f ) )
		displayFolder: 02 Jobs & Operations
		lineageTag: b1000001-0033-4a01-9a01-000000000033

		annotation PBI_FormatHint = {"isGeneralNumber":true}

