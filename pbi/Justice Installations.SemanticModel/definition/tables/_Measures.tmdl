	/// City revenue as % above or below the metro-wide average revenue per city. Positive = over-performer.
	measure 'Revenue vs Metro Avg' =
			VAR _CityRev = [Revenue (Completed Jobs)]
			VAR _MetroAvg =
			    CALCULATE (
			        [Revenue per City],
			        ALL ( City )
			    )
			RETURN
			    DIVIDE ( _CityRev - _MetroAvg, _MetroAvg )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06 Geographic
		lineageTag: a2162ee8-8ec3-4468-9f6c-4e8c6e1800c6

	/// Requests explicitly declined by the prospect (IsDeclined = 1).
	measure 'Declined Leads' = CALCULATE(COUNTROWS(Leads), Leads[IsDeclined] = 1)
		formatString: #,0
		displayFolder: 03 Leads & Pipeline
		lineageTag: 3f2a8c14-5d7b-4e93-a1c6-08b2e94f7a10

	/// Requests still open / pending: not yet converted or declined (IsOpen = 1).
	measure 'Open Leads' = CALCULATE(COUNTROWS(Leads), Leads[IsOpen] = 1)
		formatString: #,0
		displayFolder: 03 Leads & Pipeline
		lineageTag: 6b90d271-2e4a-41f8-bb35-77c0a1e5d922

	/// Distinct customers whose CreatedDate falls in the selected date range. Customer has no relationship to 'Date', so the window is applied directly to CreatedDate.
	measure 'New Customers' =
			VAR _MinDate = MIN ( 'Date'[Date] )
			VAR _MaxDateExclusive = MAX ( 'Date'[Date] ) + 1
			RETURN
			CALCULATE (
			    COUNTROWS ( Customer ),
			    Customer[Created Date] >= _MinDate,
			    Customer[Created Date] < _MaxDateExclusive
			)
		formatString: #,0
		displayFolder: 04 Customers
		lineageTag: 7c1e9a30-4b8f-4e21-9a55-2d61f0c3aa01

