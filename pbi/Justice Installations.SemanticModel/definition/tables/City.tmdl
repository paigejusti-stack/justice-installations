/// City master with state, county, and core-market flag.
table City
	lineageTag: 1329a61d-39d1-4b2c-a848-6bce34f88196

	measure 'Revenue per Customer star rating' =
			
			VAR __MAX_NUMBER_OF_STARS = 5
			VAR __MIN_RATED_VALUE = 500
			VAR __MAX_RATED_VALUE = 1300
			VAR __BASE_VALUE = [Revenue per Customer]
			VAR __NORMALIZED_BASE_VALUE =
				MIN(
					MAX(
						DIVIDE(
							__BASE_VALUE - __MIN_RATED_VALUE,
							__MAX_RATED_VALUE - __MIN_RATED_VALUE
						),
						0
					),
					1
				)
			VAR __STAR_RATING = ROUND(__NORMALIZED_BASE_VALUE * __MAX_NUMBER_OF_STARS, 0)
			RETURN
				IF(
					NOT ISBLANK(__BASE_VALUE),
					REPT(UNICHAR(9733), __STAR_RATING)
						& REPT(UNICHAR(9734), __MAX_NUMBER_OF_STARS - __STAR_RATING)
				)
		formatString: $#,0;($#,0);$0
		lineageTag: faf34e5b-d400-4bd0-80fd-de18ac06c9fe

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "StarRating"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	column CityKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6a9832b5-a334-4f85-a19d-7c168b88f45a
		summarizeBy: none
		sourceColumn: CityKey

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

