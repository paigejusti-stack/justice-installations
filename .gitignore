# ---- Power BI project (PBIP) local artifacts ----
# Machine-specific settings and paths; not portable across users
**/.pbi/localSettings.json
**/.pbi/editorSettings.json
**/.pbi/unappliedChanges.json
# Analysis Services model cache (regenerated by Power BI Desktop)
**/.pbi/cache.abf
*.abf

# ---- Power BI binaries ----
# The PBIP project is the source of truth. The only .pbix in the repo is the
# one attached to the tagged release, which is deliberately un-ignored below.
*.pbix
*.pbit
!releases/latest/*.pbix

# ---- Database backup ----
# Large binary. The DDL in sql/ rebuilds the schema without it.
database/*.bacpac
*.bak

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
desktop.ini
*~
*.tmp
*.temp
*.swp
